# Application Environment Configuration
ENVIRONMENT=development
APP_NAME="AI-Based Adaptive Online Assessment and Smart Proctoring System"
API_V1_STR="/api"

# Security & Auth
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET_KEY=dev-csrf-secret-key-change-in-production!
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database (PostgreSQL Authoritative; SQLite fallback for local test/dev)
# Production / Docker Compose: postgresql+asyncpg://proctor_user:proctor_pass@postgres:5432/proctor_db
# Local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/proctor_db
# Local SQLite Dev: sqlite+aiosqlite:///./proctor_dev.db
PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Assessment
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# AI Providers & Keys
# Priority chain order: gemini -> anthropic -> openai -> ollama -> mock (local offline NLP)
AI_PROVIDER_ORDER=gemini,anthropic,openai,ollama,mock

# 1. Google Gemini (Recommended for fast dynamic questions)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Anthropic Claude (claude-3-5-sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. OpenAI (gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# 4. Ollama (Local LLM e.g. llama3)
OLLAMA_BASE_URL=http://localhost:11434

# 5. Smart NLP Local Offline Fallback (Enabled by default when no cloud API keys are set)
MOCK_AI_ENABLED=true

# Proctoring & Exam Defaults
DEFAULT_MAX_VIOLATIONS=3
VIOLATION_DEBOUNCE_SECONDS=2.0
SWEEP_INTERVAL_SECONDS=60
DISCONNECT_IDLE_SECONDS=300
DISCONNECT_TIMEOUT_SECONDS=1800

# Rate Limiting
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
